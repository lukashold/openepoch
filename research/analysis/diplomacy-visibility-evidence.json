  "selected_native_text": {
    "map_choices": [
      {
        "line": 114,
        "key": "tx_enum_eMapRevealedLevel_0",
        "text": "N. aufgedeckt"
      },
      {
        "line": 115,
        "key": "tx_enum_eMapRevealedLevel_1",
        "text": "Erforscht"
      },
      {
        "line": 116,
        "key": "tx_enum_eMapRevealedLevel_2",
        "text": "Aufgedeckt"
      }
    ],
    "map_tooltips": [
      {
        "line": 194,
        "key": "tt_fe_revealMap_Unrevealed",
        "text": "Nicht aufgedeckt:\\nDie Karte wird durch den Schleier verdeckt und der Nebel des Krieges ist wirksam."
      },
      {
        "line": 195,
        "key": "tt_fe_revealMap_Explored",
        "text": "Erforscht:\\nDer Schleier verdeckt nicht mehr das Terrain, aber der Nebel des Krieges ist immer noch wirksam."
      },
      {
        "line": 196,
        "key": "tt_fe_revealMap_Revealed",
        "text": "Aufgedeckt:\\nEs gibt weder Schleier noch Nebel des Krieges auf der Karte, sodass alles jederzeit sichtbar ist."
      }
    ],
    "alliance_terms": [
      {
        "line": 148,
        "key": "tt_ig_allprop_dur_UntilWar",
        "text": "Bis zur Kriegserklärung:\\nDieser Vertrag wird bestehen, bis einer der Spieler den Krieg erklärt."
      },
      {
        "line": 149,
        "key": "tt_ig_allprop_dur_Timed",
        "text": "Mit Timer:\\nDas Abkommen gilt für eine in Minuten festgelegte Zeit oder bis einer der Spieler den Krieg erklärt. Wenn die Option 'Nicht zu brechende Verträge' aktiviert ist, können die Verträge in dieser Zeit nicht gebrochen werden."
      },
      {
        "line": 150,
        "key": "tt_ig_allprop_los_Full",
        "text": "Komplett:\\nAlle Spieler haben den Sichtbereich aller Einheiten und Gebäude, die ihren Verbündeten gehören."
      },
      {
        "line": 151,
        "key": "tt_ig_allprop_los_Buildings",
        "text": "Gebäude:\\nAlle Spieler haben den Sichtbereich aller Gebäude, die ihren Verbündeten gehören."
      },
      {
        "line": 152,
        "key": "tt_ig_allprop_los_MobileUnits",
        "text": "Mobile Einheiten:\\nAlle Spieler haben den Sichtbereich aller Einheiten, die ihren Verbündeten gehören."
      },
      {
        "line": 153,
        "key": "tt_ig_allprop_los_None",
        "text": "Keine:\\nVerbündete teilen sich den Sichtbereich nicht."
      },
      {
        "line": 154,
        "key": "tt_ig_allprop_bord_Full",
        "text": "Komplett:\\nAlle Einheiten Ihres Verbündeten dürfen Ihr Territorium uneingeschränkt betreten."
      },
      {
        "line": 155,
        "key": "tt_ig_allprop_bord_Civilian",
        "text": "Zivilpersonen:\\nNur die Bürger Ihres Verbündeten dürfen Ihr Territorium betreten."
      },
      {
        "line": 156,
        "key": "tt_ig_allprop_bord_Trade",
        "text": "Handel:\\nNur die Handelseinheiten Ihres Verbündeten dürfen Ihr Territorium betreten."
      },
      {
        "line": 157,
        "key": "tt_ig_allprop_bord_None",
        "text": "Keine:\\nKeine der Einheiten Ihres Verbündeten darf Ihr Territorium betreten."
      },
      {
        "line": 158,
        "key": "tt_ig_allprop_tarriff",
        "text": "Ressourcentarif:\\nFalls den Bürgern Ihres Verbündeten Zugang zu Ihrem Territorium gewährt wird, wird durch diese Einstellung ein Tarif (%) festgelegt, den diese Bürger zahlen, wenn sie in Ihrem Territorium Ressourcen sammeln. Dieser Tarif wird gezahlt, sobald die Ressourcen abgeladen werden."
      }
    ],
    "team_and_treaty_options": [
      {
        "line": 20,
        "key": "tt_fe_gametype_SoleSurvivor",
        "text": "Einziger Überlebender:\\nBeim Spieltyp 'Einziger Überlebender' kann nur ein Spieler gewinnen. Während das Spiel eingerichtet wird, können Teams gebildet werden. Im laufenden Spiel können Allianzen eingegangen werden. Sind aber nur noch zwei Teams übrig, treten diese automatisch gegeneinander an. In der Folge können neue Allianzen eingegangen werden, bis nur noch zwei Spieler übrig sind."
      },
      {
        "line": 146,
        "key": "tt_fe_gameset_teamsLocked",
        "text": "Festgelegte Teams:\\nWenn diese Option angewählt ist, können die Zuordnungen des Startteams während des Spiels nicht durch Diplomatie verändert werden."
      },
      {
        "line": 147,
        "key": "tt_fe_gameset_coopTeams",
        "text": "Kooperative Teams:\\nWenn diese Option ausgewählt ist, dann teilen sich alle Spieler desselben Startteams die Kontrolle über eine Zivilisation."
      },
      {
        "line": 153,
        "key": "tt_fe_gameset_unbTreaties",
        "text": "Nicht zu brechende Verträge:\\nWenn diese Option ausgewählt ist, können diplomatische Abkommen mit festgelegter Dauer nicht gebrochen werden."
      }
    ]
  },
