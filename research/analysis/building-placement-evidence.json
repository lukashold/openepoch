            "ENUM eTerrainMoveType {",
            "\tkTerrainMoveType_Land,\t\t\t// normal (grass) land",
            "\tkTerrainMoveType_Swamp,\t\t\t// swamp or marsh",
            "\tkTerrainMoveType_Cliff,\t\t\t// cliff (impassable -- use for cliff faces)",
            "\tkTerrainMoveType_Mountain,\t\t// mountain (impassable)",
            "\tkTerrainMoveType_Forest,\t\t// forested",
            "\tkTerrainMoveType_Coast,\t\t\t// coast/beach",
            "\tkTerrainMoveType_River,\t\t\t// river (shallow water)",
            "\tkTerrainMoveType_Ocean,\t\t\t// ocean (deep water)",
            "\tkNumTerrainMoveType,",
            "};",
            "// WARNING: if you modify this, you must also update eMovementSpeedType",
            "",
            "// WARNING: eMovementSpeedType must be kept in sync with eTerrainMoveType",
            "ENUM eMovementSpeedType {",
            "\t// the first part of the following is must match eTerrainMoveType",
            "\tkMovementSpeedType_Land,\t\t// normal (grass) land",
            "\tkMovementSpeedType_Swamp,\t\t// swamp or marsh",
            "\tkMovementSpeedType_Cliff,\t\t// cliff (impassable -- use for cliff faces)",
            "\tkMovementSpeedType_Mountain,\t// mountain (impassable)",
            "\tkMovementSpeedType_Forest,\t\t// forested",
            "\tkMovementSpeedType_Coast,\t\t// coast/beach",
            "\tkMovementSpeedType_River,\t\t// river (shallow water)",
            "\tkMovementSpeedType_Ocean,\t\t// ocean (deep water)",
            "",
            "\t// second part of this enum are special",
            "\tkMovementSpeedType_Bridge,\t\t// this should be equal to last valid eTerrainMoveType + 1"
          ]
        }
      ]
    },
