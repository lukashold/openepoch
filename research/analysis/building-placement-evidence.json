    "db/Simulation/Misc/territory.ddf": {
      "archive": "db.zip",
      "bytes": 3864,
      "sha256": "13832cfd05c7f1b7ebec01629082e2f4b3ce691c3a4ccce8af366a1ad83bf6f6",
      "encoding": "utf-8-sig",
      "line_count": 113,
      "excerpts": [
        {
          "first_line": 7,
          "last_line": 14,
          "lines": [
            "DbTerritoryInfo TheTerritoryInfo",
            "{",
            "\t// what to scale cost of buildings constructed in unclaimed territory by",
            "\tunclaimedCostModifier = 1.0",
            "\t",
            "\t// what to scale cost of buildings constructed in territory claimed by others",
            "\totherClaimedCostModifier = 1.0",
            "\t"
          ]
        },
        {
          "first_line": 28,
          "last_line": 82,
          "lines": [
            "\t// what unit types and associated minimum counts are needed to capture ",
            "\t// an unclaimed or disputed territory adjacent to one you control?",
            "\tadjacentReq =",
            "\t{",
            "\t\ttypeCounts =",
            "\t\t[",
            "\t\t\t{ type = CityCenter \tcount = 1 }",
            "\t\t]",
            "\t}",
            "\t",
            "\t// what unit types and associated minimum counts are needed to capture ",
            "\t// an unclaimed or disputed territory that is not adjacent to one you control?",
            "\t// NOTE:  the \"non adjacent requirements\" should be a superset",
            "\t// of the \"adjacent requirements\"",
            "\tnonAdjacentReq =",
            "\t{",
            "\t\ttypeCounts =",
            "\t\t[",
            "\t\t\t{ type = CityCenter\tcount = 1 }",
            "\t\t\t{ type = Fortress\tcount = 1 }",
            "\t\t]",
            "\t}",
            "\t",
            "\t// what unit types and associated minimum counts are needed to capture",
            "\t// and unclaimed or disputed territory if the player has the parthenon wonder?",
            "\tparthenonReq =",
            "\t{",
            "\t\ttypeCounts =",
            "\t\t[",
            "\t\t\t{ type = Barracks\tcount = 1 }",
            "\t\t\t{ type = Mill\t\tcount = 1 }",
            "\t\t]",
            "\t}",
            "\t",
            "\t// what unit types and associated miniumum counts are needed to capture",
            "\t// an unclaimed or disputed territory if the game is \"king of the hill\"",
            "\tkingOfTheHillReq = ",
            "\t{",
            "\t\ttypeCounts =",
            "\t\t[",
            "\t\t\t{ type = KingOfTheHill count = 1 }",
            "\t\t]",
            "\t}",
            "\t",
            "\t// what unit types and associated minimum counts are needed to keep",
            "\t// your ownership of a territory from being labeled \"disputed\"?",
            "\t// NOTE: the \"undisputed requirements\" should be a subset",
            "\t// of the \"adjacent requirements\"",
            "\tundisputedReq =",
            "\t{",
            "\t\ttypeCounts =",
            "\t\t[",
            "\t\t\t{ type = CityCenter\tcount = 1 }",
            "\t\t]",
            "\t}"
          ]
        },
        {
          "first_line": 94,
          "last_line": 110,
          "lines": [
            "\tmaximumReq =",
            "\t{",
            "\t\ttypeCounts =",
            "\t\t[",
            "\t\t\t{ type = CityCenter\tcount = 1 }",
            "\t\t\t{ type = AirDefense\tcount = 7 \tshowInUI = 1 nameInUI = tx_utn_airdefense_tReqName }",
            "\t\t\t{ type = CoastalDefense\tcount = 6 \tshowInUI = 1 nameInUI = tx_utn_coastdefense_tReqName }",
            "\t\t\t{ type = Fortress\tcount = 2 \tshowInUI = 1 }",
            "\t\t\t{ type = Wall_Tower\tcount = 7 \tshowInUI = 1 nameInUI = tx_utn_walltower_tReqName }",
            "\t\t\t{ type = House\t\tcount = 6 \tshowInUI = 1 }\t\t\t// @NOTE houses requirement is needed for various power upgrades.  please consult Andrew before removing it",
            "\t\t\t{ type = Market\t\tcount = 1 \tshowInUI = 1}\t",
            "\t\t\t{ type = Outpost\tcount = 7 \tshowInUI = 1 }",
            "\t\t\t{ type = Temple\t\tcount = 1 \tshowInUI = 1 }\t\t\t// @NOTE temple requirement is needed for \"Favor of the Gods\" region power to work correctly.  please consult Andrew before removing it",
            "\t\t\t{ type = University\tcount = 1 \tshowInUI = 1 }",
            "\t\t\t{ type = Missile_Silo\tcount = 4 \tshowInUI = 1 }",
            "\t\t]",
            "\t}"
          ]
        }
      ]
    },
