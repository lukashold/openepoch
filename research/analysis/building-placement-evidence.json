    "db/Units/building.ddf": {
      "archive": "db.zip",
      "bytes": 4339,
      "sha256": "9ffefc5fb059018d5189451b62b5c2fa0bd178f2b452934bbc95695b07181934",
      "encoding": "utf-8-sig",
      "line_count": 187,
      "excerpts": [
        {
          "first_line": 4,
          "last_line": 51,
          "lines": [
            "UnitType BareBoneBuilding\t\t// building with no ability",
            "{",
            "\townerType = PlayerOrWorld",
            "\tplacementType = Building",
            "\tproperties {",
            "\t\trps = Building",
            "\t\thitpoints = 666",
            "\t\tFootprintType = kFootprintType_Rectangle",
            "\t\trequiredOpenSides = kBuildingOpenSides_None",
            "\t}",
            "\tattributes = [ RectangularFootprint ]",
            "\tfullMapOverlay { sprite = spr_fullmap_building }",
            "\ticon = icon_unit_default_building",
            "}",
            "",
            "UnitType NoProduceBuilding",
            "{",
            "\tparent = BareBoneBuilding",
            "\tabilities = [",
            "\t\tResearch {}",
            "\t\tConvertable { ",
            "\t\t\tconvertTimeModifier = 200.0;  //",
            "\t\t\tgarrisonedUnitModifier = 0.0; // 10% increase in capture time",
            "\t\t\tgarrisonedUnitDamage = 0.0;\t  // hitpoints subtracted from capturer per round per garrisoned unit",
            "\t\t\tdamageRate = 0.0;\t\t\t  // hitpoints subtracted from capture target hitpoints per round",
            "\t\t\tcapture = 1;",
            "\t\t} // may be captured",
            "",
            "\t\tLOS { range = 0 }",
            "\t]",
            "}",
            "",
            "UnitType Building",
            "{",
            "\townerType = PlayerOnly",
            "\tparent = NoProduceBuilding",
            "\tabilities = [",
            "\t\tProduce {}",
            "\t]",
            "}",
            "",
            "// a variation of Building that can belong to either player or world",
            "UnitType PlayerOrWorldBuilding",
            "{",
            "\tparent = NoProduceBuilding",
            "\tabilities = [",
            "\t\tProduce {}",
            "\t]"
          ]
        }
      ]
    },
