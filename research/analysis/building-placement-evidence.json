    "DbHdrs/DbUnitDefEnums.h": {
      "archive": "hdrs.zip",
      "bytes": 15951,
      "sha256": "c2fd2ef87d9927872b913a30eaaf267a096b7e4c5221e145020a7173afeb79e9",
      "encoding": "utf-8-sig",
      "line_count": 383,
      "excerpts": [
        {
          "first_line": 77,
          "last_line": 101,
          "lines": [
            "ENUM eUnitOwnerType {",
            "\tkUnitOwnerType_PlayerOnly = 1,\t// only a player can have this unit (default)",
            "\t\t\t\t\t\t\t\t\t// set to 1 so we don't get it unintentionally",
            "\tkUnitOwnerType_WorldOnly,\t\t// only the world can have this unit",
            "\tkUnitOwnerType_PlayerOrWorld,\t// player or world can have this unit",
            "\tkUnitOwnerType_Invalid,\t\t\t// not a valid unit type, just used for inheritance",
            "};",
            "",
            "//\tThis enum determines how the unit is placed by the UI",
            "",
            "ENUM eUnitPlacementType {",
            "\tkUnitPlacementType_Default,\t\t// no constraints",
            "\tkUnitPlacementType_Building,\t// building: rotate 45 degrees, tile bounds, flatten terr",
            "\tkUnitPlacementType_Dock,\t\t// like building, but must build on coast",
            "\tkUnitPlacementType_NearWater,\t// like dock, but rather than overlapping water just needs to be near water (eg for coastal defense)",
            "\tkUnitPlacementType_DeepWater,\t// deep water only (e.g., fish resource)",
            "\tkUnitPlacementType_Airport,\t\t// ???",
            "\tkUnitPlacementType_Road,\t\t// road",
            "\tkUnitPlacementType_Bridge,\t\t// bridge",
            "\tkUnitPlacementType_Wall,\t\t// wall",
            "\tkUnitPlacementType_Farm,\t\t// farm",
            "\tkUnitPlacementType_OnOil,\t\t// Oil rigs get built on top of oil",
            "\tkUnitPlacementType_OnUranium,\t// Uranium extraction buildings get built on top of uranium",
            "\tkUnitPlacementType_Unplaceable,\t// cannot be explicitly placed (projectiles, some wall/road units)",
            "};"
          ]
        },
        {
          "first_line": 309,
          "last_line": 342,
          "lines": [
            "// So, starting from positive x, ccw around the axes going from low bit to",
            "// high bit.  A one in a bit means that that side MUST be allowed to be open,",
            "// and other buildings cannot be built adjacent to that side.",
            "// X and Y are talking about the sides of the building as if it were placed in",
            "// the world with zero rotation (which never happens).  Note that this does not",
            "// necessarily correspond to the X and Y coordinates of the model.",
            "ENUM eBuildingOpenSides {",
            "\tkBuildingOpenSides_None = 0x80,\t\t\t\t// 1000 0000",
            "\tkBuildingOpenSides_PosX = 0x81,\t\t\t\t// 1000 0001",
            "\tkBuildingOpenSides_PosY = 0x82,\t\t\t\t// 1000 0010",
            "\tkBuildingOpenSides_PosXPosY = 0x83,\t\t\t// 1000 0011",
            "\tkBuildingOpenSides_NegX = 0x84,\t\t\t\t// 1000 0100",
            "\tkBuildingOpenSides_PosXNegX = 0x85,\t\t\t// 1000 0101",
            "\tkBuildingOpenSides_PosYNegX = 0x86,\t\t\t// 1000 0110\t",
            "\tkBuildingOpenSides_PosXPosYNegX = 0x87,\t\t// 1000 0111",
            "\tkBuildingOpenSides_NegY = 0x88,\t\t\t\t// 1000 1000",
            "\tkBuildingOpenSides_PosXNegY = 0x89,\t\t\t// 1000 1001",
            "\tkBuildingOpenSides_PosYNegY = 0x8A,\t\t\t// 1000 1010",
            "\tkBuildingOpenSides_PosXPosYNegY = 0x8B,\t\t// 1000 1011",
            "\tkBuildingOpenSides_NegXNegY = 0x8C,\t\t\t// 1000 1100",
            "\tkBuildingOpenSides_PosXNegXNegY = 0x8D,\t\t// 1000 1101",
            "\tkBuildingOpenSides_PosYNegXNegY = 0x8E,\t\t// 1000 1110",
            "\tkBuildingOpenSides_PosXPosYNegXNegY = 0x8F\t// 1000 1111",
            "};",
            "",
            "// This goes with the above enum.  Doesn't need to be used in .ddfs (that I know of)",
            "// It's for doing bitwise comparisons with the above.",
            "enum eBuildingSides",
            "{",
            "\tkBuildingSide_PosX = 0x1,",
            "\tkBuildingSide_PosY = 0x2,",
            "\tkBuildingSide_NegX = 0x4,",
            "\tkBuildingSide_NegY = 0x8,",
            "};"
          ]
        }
      ]
    },
    "DbHdrs/DbUnitDefs.h": {
      "archive": "hdrs.zip",
      "bytes": 24827,
      "sha256": "afde5529ed266cc3995dfa3c48eecc3fd17f2eac7db65c880d077ac277cd26c3",
      "encoding": "utf-8-sig",
      "line_count": 600,
      "excerpts": [
        {
          "first_line": 66,
          "last_line": 84,
          "lines": [
            "\t// for rectangular footprint, size is impassable area and footprint size",
            "\t//   is the total area for placement and undertexture.",
            "\t// for elliptical footprint, SizeX is radius along the major axis (middle",
            "\t//   to front) and SizeY is radius along the minor axis (middle to right).",
            "\t// the FootprintType enum determines what type of shape this unit occupies.",
            "\tenum eFootprintType FootprintType;\t\t",
            "\tfloat\tDiameter;\t\t\t// used with the circle type radius*2",
            "\tfloat\tFootprintSizeX;\t\t// depending on the type of footprint this is interpreted differently",
            "\tfloat\tFootprintSizeY;\t\t// they are ignored for ellipse and are the size of the rectangle if rectangle type",
            "\tfloat\tSizeX;\t\t\t\t// used by both rectangle and circle",
            "\tfloat\tSizeY;\t\t\t\t// used by both rectangle and circle",
            "\t// those two values determine where the upper left corner of the impassable area ",
            "\t// is placed relative to the upper left corner of the footprint, default is both corner are aligned",
            "\tfloat\tOffsetX;",
            "\tfloat\tOffsetY;",
            "\tfloat\tUndertextureSizeX;\t\t// size of the unit's undertexture",
            "\tfloat\tUndertextureSizeY;",
            "\tfloat\tUndertextureOffsetX;\t// offset of the unit's undertexture",
            "\tfloat\tUndertextureOffsetY;"
          ]
        },
        {
          "first_line": 135,
          "last_line": 180,
          "lines": [
            "\tDBINDEX(DbSprite) m_citizenManagerCursorSprite;\t// sprite to use in placement in citizen manager",
            "\tenum eUnitOwnerType ownerType;\t\t\t\t// owner type (eUOT_xxxx)",
            "\tUSER enum eUnitOwnerType inheritedOwnerType; // computed post-load",
            "\tenum eUnitPlacementType placementType;\t\t// placement type (eUPT_xxxx)",
            "\tUSER enum eUnitPlacementType inheritedPlacementType;\t// computed post-load",
            "\tDC(DbUnitTypeProperties) *properties;\t\t// properties (see above)",
            "\tDC(DbUnitTypeSounds) *sounds;\t\t\t\t// unit type UI sounds",
            "\tLSizedArray<VARDC> abilities;\t\t\t\t// array of variable abilities",
            "",
            "\t// Arrays of attribute bits to set and clear.  For each ancestor, bits are",
            "\t// first set, and then cleared from the attributes and nonAttributes arrays,",
            "\t// respectively.  You can override ancestors attributes.",
            "\tLSizedArray<enum eUnitTypeAttr> attributes;\t",
            "\tLSizedArray<enum eUnitTypeAttr> nonAttributes;",
            "\t",
            "",
            "\t//for inheritance tracking:",
            "\tUSERPTR(DbUnitTypeDef) m_pParent;\t\t\t\t// the parent of this DbUnitTypeDef, or NULL if root (?)",
            "\tUSER LDynArray<uint16> m_aiChildren;\t\t// an array of the DBINDEXes of all the unit types descended",
            "\t\t\t\t\t\t\t\t\t\t\t// from this DbUnitTypeDef.",
            "",
            "ENDVARS",
            "\tenum eUnitOwnerType GetOwnerType()\t\t\t// get owner type via inheritance",
            "\t{",
            "\t\treturn inheritedOwnerType;",
            "\t}",
            "\tenum eUnitPlacementType GetPlacementType()\t// get placement type via inheritance",
            "\t{",
            "\t\treturn inheritedPlacementType;",
            "\t}",
            "\t//is this a unit that must be placed when created in game",
            "\tbool IsPlaceableUnit()\t\t\t",
            "\t{\t\t\t\t\t\t",
            "\t\tswitch(inheritedPlacementType) ",
            "\t\t{",
            "\t\t\tcase kUnitPlacementType_Building:\t",
            "\t\t\tcase kUnitPlacementType_Dock:",
            "\t\t\tcase kUnitPlacementType_NearWater:\t",
