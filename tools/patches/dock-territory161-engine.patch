+        let mut count = 0;
+        for line in oracle.lines() {
+            let fields: Vec<_> = line.split_whitespace().collect();
+            assert_eq!(fields.len(), 8);
+            let point = |x: usize, z: usize| [x,z].map(|index| f32::from_bits(u32::from_str_radix(fields[index],16).unwrap()));
+            let expected = |index: usize| fields[index].parse::<u8>().ok()
+                .map(|region| (region, point(index+1, index+2)));
+            let input = point(0,1);
+            let first = resolve_territory(input,4,archived_territory);
+            assert_eq!(first,expected(2),"{input:?}");
+            let policy = resolve_territory(first.map_or(input,|(_,found)| found),5,archived_territory);
+            assert_eq!(policy,expected(5),"{input:?}");
+            count += 1;
+        }
+        assert_eq!(count, 1552);
     }
 
